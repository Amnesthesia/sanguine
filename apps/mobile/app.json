{
  "expo": {
    "name": "Sanguine",
    "slug": "sanguine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "sanguine",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.sanguine.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#6A1220",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/android-icon-background.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6A1220",
          "image": "./assets/brand/splash-wordmark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#6A1220",
            "image": "./assets/brand/splash-wordmark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "app.sanguine.mobile",
      "supportsTablet": false
    }
  }
}
