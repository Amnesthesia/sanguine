{
  "expo": {
    "name": "Sanguine",
    "slug": "sanguine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "sanguine",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.sanguine.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5E8E2",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/android-icon-background.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.WRITE_MENSTRUATION",
        "android.permission.health.READ_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.WRITE_INTERMENSTRUAL_BLEEDING",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE",
        "android.permission.health.WRITE_BASAL_BODY_TEMPERATURE",
        "android.permission.health.READ_OVULATION_TEST",
        "android.permission.health.WRITE_OVULATION_TEST",
        "android.permission.health.READ_CERVICAL_MUCUS",
        "android.permission.health.WRITE_CERVICAL_MUCUS",
        "android.permission.health.READ_SEXUAL_ACTIVITY",
        "android.permission.health.WRITE_SEXUAL_ACTIVITY",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5E8E2",
          "image": "./assets/brand/splash-lockup.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#2A1518",
            "image": "./assets/brand/splash-lockup-dark.png"
          },
          "android": {
            "image": "./assets/brand/splash-android-blank.png",
            "imageWidth": 200,
            "backgroundColor": "#F5E8E2",
            "dark": {
              "image": "./assets/brand/splash-android-blank.png",
              "backgroundColor": "#2A1518"
            }
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      "./plugins/withDevMenuMetaData",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.sanguine.mobile.widgets",
          "groupIdentifier": "group.app.sanguine.mobile",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Sanguine",
              "description": "The day of your cycle.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "contentMarginsDisabled": false
              }
            }
          ]
        }
      ],
      "./plugins/withDiscreetLabel",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Notes",
            "ios": "./assets/brand/notes-icon.png",
            "android": {
              "foregroundImage": "./assets/brand/notes-android-foreground.png",
              "backgroundColor": "#6B6165"
            }
          }
        ]
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-background-task",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sanguine reads the period flow, intermenstrual bleeding, basal body temperature, wrist temperature, ovulation test, cervical mucus and sexual activity records you switch on in Settings, so your cycle log stays in step with Apple Health. Nothing is shared or sent anywhere.",
          "NSHealthUpdateUsageDescription": "Sanguine writes the period flow, intermenstrual bleeding, basal body temperature, ovulation test, cervical mucus and sexual activity entries you log, so they appear in Apple Health. Wrist temperature is never written.",
          "background": true
        }
      ],
      "react-native-health-connect",
      [
        "react-native-libsodium",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "app.sanguine.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "EXDevMenuShowFloatingActionButton": false,
        "EXDevMenuShowsAtLaunch": false,
        "EXDevMenuIsOnboardingFinished": true,
        "NSUbiquitousContainers": {
          "iCloud.app.sanguine.mobile": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Sanguine",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      },
      "icon": {
        "light": "./assets/brand/icon.png",
        "dark": "./assets/brand/icon-dark.png",
        "tinted": "./assets/brand/icon-tinted.png"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.app.sanguine.mobile"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.app.sanguine.mobile"
        ]
      }
    }
  }
}
