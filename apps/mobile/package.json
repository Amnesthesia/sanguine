  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "eas:login": "npx eas-cli login",
    "eas:init": "npx eas-cli init",
    "build:android:dev": "EAS_NO_VCS=1 npx eas-cli build --profile development --platform android",
    "build:android:preview": "EAS_NO_VCS=1 npx eas-cli build --profile preview --platform android",
    "build:android:local": "scripts/build-android-local.sh",
    "build:android:production": "EAS_NO_VCS=1 npx eas-cli build --profile production --platform android",
    "build:ios:dev": "EAS_NO_VCS=1 npx eas-cli build --profile development --platform ios",
    "build:ios:preview": "EAS_NO_VCS=1 npx eas-cli build --profile preview --platform ios",
    "build:ios:production": "EAS_NO_VCS=1 npx eas-cli build --profile production --platform ios",
    "update:preview": "npx eas-cli update --channel preview --environment preview",
    "update:production": "npx eas-cli update --channel production --environment production",
    "submit:android": "npx eas-cli submit --profile production --platform android --latest",
    "submit:ios": "npx eas-cli submit --profile production --platform ios --latest"
  },
  "private": true
